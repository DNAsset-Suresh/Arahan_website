# ---------------------------------------------------------------------------
# Arahan Enterprises — enquiry mail configuration
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored
# and must never be committed or shipped to the browser.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- SMTP transport --------------------------------------------------------
# Use the provider that owns your sending domain. Port 587 = STARTTLS,
# port 465 = implicit TLS (set SMTP_SECURE=true for 465).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=

# Envelope sender. Must be an address the SMTP account is allowed to send as,
# otherwise most providers reject the message as spoofing. The visitor's own
# address is NEVER used here - it goes in Reply-To instead.
MAIL_FROM="Arahan Enterprises" <no-reply@example.com>

# --- Where enquiries are delivered ----------------------------------------
# Server-side only. The browser never sees these and can never choose them.
# Placeholders on purpose: this template is committed, so put the real
# addresses in .env (which is gitignored), never here.
OWNER_EMAIL_1=owner1@example.com
OWNER_EMAIL_2=owner2@example.com

# --- Server ----------------------------------------------------------------
PORT=8765

# Comma-separated origins allowed to POST /api/contact. Leave empty when the
# API and the site are served from the same origin (the default setup), which
# needs no CORS at all.
ALLOWED_ORIGINS=

# Set to 1 to compose the emails and log them WITHOUT sending. Useful for
# testing the whole flow before real SMTP credentials exist.
MAIL_DRYRUN=0
